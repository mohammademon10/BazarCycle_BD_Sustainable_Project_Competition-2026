# BazarCycle BD - Backend Environment Configuration

# Database Connection (Supabase PostgreSQL in production or local SQLite fallback)
DATABASE_URL=sqlite:///./bazarcycle.db
# For Supabase PostgreSQL, use:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret Key (Generate a random 32+ character string in production)
JWT_SECRET=bazarcycle_bd_super_secure_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Environment (development / production)
ENVIRONMENT=development
